{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // src/index.ts is the action entry bundled into dist/; scripts/**/*.mjs
  // holds standalone node scripts such as check-action-pins.
  "entry": ["src/index.ts", "scripts/**/*.mjs"],
  // dist/ is the committed action bundle, __fixtures__/ holds vitest mocks and
  // .licenses/ is generated by licensed.
  "ignorePatterns": ["dist/**", "__fixtures__/**", ".licenses/**"],
  // Linux CI needs this rollup native binary until the rolldown migration;
  // nothing imports it, so fallow would otherwise remove it as unused.
  "ignoreDependencies": ["@rollup/rollup-linux-x64-gnu"],
  "rules":
  {
    "unused-dependencies": "error",
  },
}
