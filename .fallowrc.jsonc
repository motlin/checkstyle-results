{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // The two eslint packages leave with the rest of the ESLint setup, and Linux
  // CI needs the rollup native binary until the rolldown migration; nothing
  // imports them, so fallow would otherwise remove them as unused.
  "ignoreDependencies": ["@eslint/compat", "eslint-import-resolver-typescript", "@rollup/rollup-linux-x64-gnu"],
}
