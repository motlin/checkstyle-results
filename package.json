{
  "name": "checkstyle-results",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action to convert CheckStyle XML reports to GitHub annotations",
  "keywords": [
    "actions"
  ],
  "homepage": "https://github.com/motlin/checkstyle-results",
  "bugs":
  {
    "url": "https://github.com/motlin/checkstyle-results/issues"
  },
  "license": "Apache-2.0",
  "author": "Craig Motlin",
  "repository":
  {
    "type": "git",
    "url": "git+https://github.com/motlin/checkstyle-results.git"
  },
  "type": "module",
  "exports":
  {
    ".": "./dist/index.js"
  },
  "scripts":
  {
    "preinstall": "npx only-allow pnpm",
    "oxlint": "vp lint . --fix",
    "oxlint:ci": "vp lint . --format github",
    "fmt": "oxfmt-next-line",
    "fmt:ci": "oxfmt-next-line --check",
    "fallow": "fallow fix --yes --no-create-config",
    "fallow:ci": "fallow dead-code",
    "typecheck": "tsc --noEmit",
    "test": "node node_modules/vitest/dist/cli.js",
    "test:ui": "node node_modules/vitest/dist/cli.js --ui",
    "bundle": "vp run fmt && vp run package",
    "coverage": "vp exec make-coverage-badge --output-path ./badges/coverage.svg",
    "local-action": "vp exec local-action . src/main.ts .env",
    "package": "rm -rf ./dist && vp exec rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "package:watch": "vp run package -- --watch",
    "all": "vp run fmt && vp run oxlint && vp run test run && vp run coverage && vp run package",
    "prepare": "VITE_GIT_HOOKS=0 vp config"
  },
  "dependencies":
  {
    "@actions/core": "^3.0.1",
    "@actions/glob": "^0.7.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies":
  {
    "@eslint/compat": "^2.0.2",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@github/local-action": "^7.0.1",
    "@jest/globals": "^30.4.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.1",
    "fallow": "^3.33.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "make-coverage-badge": "^1.2.0",
    "markdownlint-cli2": "^0.23.3",
    "rollup": "^4.62.4",
    "ts-jest": "^29.4.12",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "optionalDependencies":
  {
    "@rollup/rollup-linux-x64-gnu": "*"
  },
  "engines":
  {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.12.1"
}
